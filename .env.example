# Copy to .env and adjust. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite is used when DATABASE_URL is empty. Production example:
# DATABASE_URL=postgres://medipos:password@localhost:5432/medipos
DATABASE_URL=

# Subscription rules
TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_PAYMENT_INSTRUCTIONS=Contact ThingBD support to renew or upgrade your subscription.

# Attendance: set True when nginx (or another proxy) passes the visitor's address in X-Forwarded-For.
BEHIND_PROXY=False

# Messages. SITE_URL starts the links in SMS/email (e.g. https://app.example.com).
SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=MediPOS <no-reply@medipos.local>
# Platform SMS gateway for pharmacies on MediPOS SMS credits. Empty URL = SMS are only logged.
# Example: https://provider.example/api/smsapi?api_key={api_key}&type=text&number={to}&senderid={sender}&message={message}
SMS_GATEWAY_URL=
SMS_GATEWAY_METHOD=GET
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=
SMS_GATEWAY_SUCCESS_TEXT=
# True sends right away; False leaves messages for `manage.py send_messages` (run it every minute from cron).
MESSAGES_SEND_NOW=True

# Support assistant (optional): API key for the AI provider chosen in Platform → Support assistant, if not typed there.
SUPPORT_AI_API_KEY=

# Used by `manage.py seed_demo` for the demo platform admin and pharmacy owner (dev only).
DEMO_PASSWORD=MediPos#Demo2026
